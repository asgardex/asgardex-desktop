 const BASE_URL = 'https://1click.chaindefuser.com';
+
+function toOneClickAmountString(amount) {
+    if (typeof amount !== 'string') return amount;
+    if (/^\d+$/.test(amount)) return amount;
+    // Expand scientific notation / decimals to a pure integer digit string.
+    const match = amount.trim().toLowerCase().match(/^([+-]?)(\d+)(?:\.(\d+))?(?:e([+-]?\d+))?$/);
+    if (!match) return amount;
+    const sign = match[1] === '-' ? '-' : '';
+    const intPart = match[2];
+    const fracPart = match[3] || '';
+    const exp = parseInt(match[4] || '0', 10);
+    const digits = intPart + fracPart;
+    const fracLen = fracPart.length;
+    const newExp = exp - fracLen;
+    let result;
+    if (newExp >= 0) {
+        result = digits + '0'.repeat(newExp);
+    } else {
+        const split = digits.length + newExp;
+        if (split <= 0) {
+            result = '0';
+        } else {
+            // truncate fractional base units
+            result = digits.slice(0, split) || '0';
+        }
+    }
+    result = result.replace(/^0+(?=\d)/, '');
+    return sign === '-' ? '0' : result; // amounts must be non-negative integers
+}
