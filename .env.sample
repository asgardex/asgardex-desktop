# ASGARDEX
# Set default network - needs to be part of `VITE_NETWORKS`
VITE_DEFAULT_NETWORK=mainnet
# Logging: error | warn | info | debug (empty = off)
# VITE_LOG_LEVEL=info

# Midgard
VITE_MIDGARD_TESTNET_URL=https://testnet.midgard.thorchain.info
VITE_MIDGARD_STAGENET_URL=
VITE_MIDGARD_MAINNET_URL=https://gateway.liquify.com/chain/thorchain_midgard

# THORnode (primary: Liquify public gateway)
VITE_TESTNET_THORNODE_API=https://testnet.thornode.thorchain.info
VITE_STAGENET_THORNODE_API=
VITE_MAINNET_THORNODE_API=https://gateway.liquify.com/chain/thorchain_api
VITE_STAGENET_THORNODE_RPC=
VITE_MAINNET_THORNODE_RPC=https://gateway.liquify.com/chain/thorchain_rpc

# Asgardex.xyz mainnet fallbacks (own path token — not Liquify). Full URLs from GH secrets.
#   API: https://thornode.asgardex.xyz/<ASGARDEX_TOKEN>/api
#   RPC: https://thornode.asgardex.xyz/<ASGARDEX_TOKEN>/rpc
# VITE_ASGARDEX_THORNODE_API=
# VITE_ASGARDEX_THORNODE_RPC=

# Liquify portal keys — Liquify gateway only (never applied to asgardex.xyz).
# Same path form for both; different keys: https://gateway.liquify.com/api=<KEY>
# API key → THORNode REST (inbound_addresses, etc.). Expert shows …/chain/thorchain_api
# RPC key → Tendermint RPC (sign/broadcast). Expert shows …/chain/thorchain_rpc
# Production GH secrets: VITE_LIQUIFY_THORCHAIN_API_KEY / VITE_LIQUIFY_THORCHAIN_RPC_KEY
# VITE_LIQUIFY_THORCHAIN_API_KEY=
# VITE_LIQUIFY_THORCHAIN_RPC_KEY=

# MAYAnode
VITE_MAINNET_MAYANODE_API=https://mayanode.mayachain.info
VITE_MAINNET_MAYANODE_RPC=https://tendermint.mayachain.info
VITE_STAGENET_MAYANODE_API=https://stagenet.mayanode.mayachain.info
VITE_TESTNET_MAYANODE_API=https://testnet.mayanode.mayachain.info

# MAYAMIDGARD
VITE_MIDGARD_MAYA_MAINNET_URL=https://midgard-maya.liquify.com
VITE_MIDGARD_MAYA_STAGENET_URL=https://stagenet-midgard.mayachain.info

# BCH
VITE_HASKOIN_BCH_TESTNET_URL=https://api.haskoin.com/bchtest
VITE_HASKOIN_BCH_MAINNET_URL=https://api.haskoin.com/bch
VITE_BCH_NODE_TESTNET_URL=https://testnet.bch.thorchain.info
VITE_BCH_NODE_MAINNET_URL=https://mainnet.bch.thorchain.info
VITE_BCH_NODE_USERNAME=XXX
VITE_BCH_NODE_PASSWORD=XXX

# BTC
VITE_SOCHAIN_URL=https://sochain.com/api/v2
VITE_HASKOIN_BTC_TESTNET_URL=https://api.haskoin.com/btctest
VITE_HASKOIN_BTC_MAINNET_URL=https://api.haskoin.com/btc

# DOGE/BTC
VITE_BLOCKCYPHER_URL=https://api.blockcypher.com/v1
VITE_BLOCKCYPHER_API_KEY=xxx

# ETH AVAX BSC ARB BASE
VITE_ETHERSCAN_API_KEY=XXX
VITE_INFURA_PROJECT_ID=XXX
VITE_ETHPLORER_API_KEY=XXX
VITE_ETHPLORER_API_URL=https://api.ethplorer.io

# LTC
VITE_LTC_NODE_TESTNET_URL=https://testnet.ltc.thorchain.info
VITE_LTC_NODE_MAINNET_URL=
VITE_LTC_NODE_USERNAME=XXX
VITE_LTC_NODE_PASSWORD=XXX

# COSMOS
VITE_COSMOS_MAINNET_LCD=https://lcd-cosmoshub.keplr.app

#ANKR
VITE_ANKR_API_KEY=XXX

#ASG
VITE_ASGARDEX_THORNAME=dx
VITE_ASGARDEX_BROKER_URL=XXX
VITE_ASGARDEX_AFFILIATE_BROKERS_ADDRESS=XXX
# OneClick (NEAR Intents) — JSON map of destination chain → native affiliate address
# VITE_ASGARDEX_ONECLICK_AFFILIATES={"BTC":"bc1...","ETH":"0x..."}
VITE_ASGARDEX_ONECLICK_AFFILIATES=
# Optional API key (anonymous works; keyed requests are rate-limited less aggressively)
# VITE_ASGARDEX_ONECLICK_API_KEY=XXX


#SOL
VITE_SOL_API_KEY=XXX

#ADA
VITE_ADA_API_KEY=XXX

#NOWNODES (for ZEC)
VITE_NOWNODES_API_KEY=XXX
