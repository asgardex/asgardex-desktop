# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/node_modules

/coverage
/build
/release

.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks

.eslintcache

# storybook static
/storybook-static

# don't share .env, but .env.sample
.env

dev-app-update.yml
/.idea/

# Trunk CLI cache directories
.trunk/tools/
.trunk/tmp/
.trunk/out/
.trunk/logs/

stats.html

# Playwright E2E test artifacts
/test-results/
/playwright-report/
playwright-results.json
*.spec.js
*.spec.js.map

# Test screenshots and artifacts
test-results/**/*.png
test-results/**/*.webm
test-results/**/*.html
test-results/**/*.json
test-results/**/*.log

# Playwright cache and temporary files
.last-run.json

# Additional test artifacts and caches
tests-e2e/**/*.png
tests-e2e/**/*.webm
tests-e2e/**/*.mp4
*.trace
.playwright/

# IDE and editor files (if not already covered)
.vscode/settings.json
*.swp
*.swo
